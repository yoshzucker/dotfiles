;; ---- Direction -------------------------------------------------------------

;; Every paragraph runs left to right.
;;
;; Left at nil, the direction of each paragraph is worked out on every
;; redisplay by reading its text for a right-to-left character, and the
;; bracket-pairing pass the Unicode algorithm adds is run over every
;; parenthesis on the screen -- which in Lisp is all of them.  Nothing written
;; here is Arabic or Hebrew.  Should some arrive, it is still drawn right to
;; left within its line; only the paragraph around it is not turned round.
(setq-default bidi-paragraph-direction 'left-to-right)
(setq bidi-inhibit-bpa t)

;; ---- Apply -----------------------------------------------------------------

(defun my/char-width-apply-ranges (ranges)
  "Apply RANGES (list of (LO HI WIDTH)) to `char-width-table'."
  (pcase-dolist (`(,lo ,hi ,w) ranges)
    (set-char-table-range char-width-table (cons lo hi) w)))

(defun my/char-width-setup (&optional frame)
  "Match `char-width-table' to the glyph advances of FRAME's default font.
The default font is only settled after my-ui-face applies it, so this runs
from `after-init-hook' / `after-make-frame-functions'."
  (when (display-graphic-p frame)
    ;; Font-specific correction; add a when-block per extra font.
    (let ((family (and (boundp 'my/font-default) (plist-get my/font-default :family))))
      (when (equal family "PlemolJP NF")
        (my/char-width-apply-ranges my/plemoljp-gui-char-width-ranges)
        ;; Box-drawing is 1-cell drawing in the font (see build-plemoljp-nf).
        ;; Forced here because gen-plemoljp-char-width skips U+2500-257F.
        ;; set-fontset-font cannot reroute it: on macOS the face :family
        ;; covers box-drawing and wins over the fallback fontset.
        (set-char-table-range char-width-table (cons #x2500 #x257F) 1)))))

(add-hook 'after-init-hook #'my/char-width-setup)
(add-hook 'after-make-frame-functions #'my/char-width-setup)

(provide 'my-ui-char)

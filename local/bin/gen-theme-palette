#!/usr/bin/env bash
#
# gen-theme-palette -- write the shell palette table for an Emacs theme.
#
#   gen-theme-palette [THEME]        # default: gensho
#
# The shell cannot run Emacs at every prompt, so the colors a theme computes
# from HSLuv are harvested once and committed as data.  This writes
# config/shell/zsh/palette-<theme>.sh, which colors.sh sources.
#
# Two tables come out, because colors.sh has two audiences:
#
#   _THEME_ANSI_{DARK,LIGHT}  the sixteen ANSI slots in canonical order, for
#                             painting the terminal itself (OSC 4).  From
#                             <theme>-export-palette 'hex-list.
#   _THEME_SEM_{DARK,LIGHT}   the theme's own names -- mono0..mono7, the dim
#                             levels, the hues -- for the programs that style
#                             themselves from the ramp (tmux, fzf, the prompt).
#                             From <theme>-palette.
#
# The same hex appears in both where a level also holds a slot.  That is
# duplicated data in a generated file, which costs nothing; deriving one table
# from the other would instead duplicate the slot assignment as hand-written
# shell, and that is the part that goes stale when the assignment moves.
#
# Re-run after changing a theme's palette or its ANSI slot assignment.

set -euo pipefail

THEME="${1:-gensho}"
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
OUT="$REPO/config/shell/zsh/palette-$THEME.sh"
THEME_DIR="$HOME/Developer/$THEME-theme"
HSLUV="$HOME/.emacs.d/straight/build/hsluv"

[ -d "$THEME_DIR" ] || { echo "no theme at $THEME_DIR" >&2; exit 1; }

emacs -Q --batch \
      --eval "(progn
  (add-to-list 'load-path \"$HSLUV\")
  (add-to-list 'custom-theme-load-path \"$THEME_DIR\")
  (load-theme '$THEME t)
  (let ((ansi (intern \"$THEME-export-palette\"))
        (sem  (intern \"$THEME-palette\")))
    (princ (format \"# palette-$THEME.sh -- generated by gen-theme-palette; do not edit.\n#\n# Source: $THEME-theme (%s 'hex-list, %s).  Regenerate with:\n#   gen-theme-palette $THEME\n\" ansi sem))
    (dolist (mode '(dark light))
      (let* ((frame-background-mode mode)
             (upper (upcase (symbol-name mode))))
        (princ (format \"\ntypeset -ga _THEME_ANSI_%s=(\n\" upper))
        (let ((i 0))
          (dolist (hex (funcall ansi 'hex-list))
            (princ (format \"  %-8s# %2d\n\" (substring hex 1) i))
            (setq i (1+ i))))
        (princ \")\n\")
        (princ (format \"\ntypeset -gA _THEME_SEM_%s=(\n\" upper))
        (dolist (cell (funcall sem))
          (princ (format \"  %-8s %s\n\" (car cell) (substring (cdr cell) 1))))
        (princ \")\n\")))))" > "$OUT"

echo "wrote $OUT"

#!/usr/bin/env bash
#
# gen-theme-palette -- write the palettes other programs take from an Emacs theme.
#
#   gen-theme-palette [THEME]        # default: gensho
#
# Nothing outside Emacs can compute the colors a theme derives from HSLuv, so
# they are harvested once and committed as data.  Three kinds of file come
# out:
#
#   config/ghostty/themes/<theme>-{light,dark}
#   config/mintty/themes/<theme>-{light,dark}
#       The terminal's own colors: the sixteen ANSI slots, from
#       <theme>-export-palette 'hex-list, and the background, foreground and
#       cursor, from the ramp (mono1, mono7, mono6).  The terminal paints
#       itself from these, whatever shell runs inside it.
#
#   config/everything/themes/<theme>-{light,dark}.ini
#       Everything's result-list colors, as the keys of its Everything.ini.
#       The list is read the way the theme reads a completion list: the
#       surface at mono1, the current item at mono0 as vertico-current is,
#       an unfocused selection at mono2, and the matched text in cyan as
#       orderless-match-face-0 is.  Only the list takes colors; the search
#       box, status bar and menus stay Windows's.  bootstrap.ps1 writes the
#       keys into the live Everything.ini.
#
# The zsh prompt needs no file: every level it uses has a slot, so it names
# the slot and follows the terminal.
#
# Re-run after changing a theme's palette or its ANSI slot assignment.

set -euo pipefail

THEME="${1:-gensho}"

# Resolve through the symlink this is deployed as, so the repository is found
# whether the command is run from the checkout or from ~/.local/bin.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
REPO="$(cd -P "$(dirname "$src")/../.." && pwd)"
THEME_DIR="$HOME/Developer/$THEME-theme"
HSLUV="$HOME/.emacs.d/straight/build/hsluv"

[ -d "$THEME_DIR" ] || { echo "no theme at $THEME_DIR" >&2; exit 1; }

# One line per color: VARIANT KIND KEY HEX, where KIND is `ansi' (KEY the
# slot, 0-15) or `sem' (KEY the theme's name for the level).
data="$(emacs -Q --batch \
      --eval "(progn
  (add-to-list 'load-path \"$HSLUV\")
  (add-to-list 'custom-theme-load-path \"$THEME_DIR\")
  (load-theme '$THEME t)
  (let ((ansi (intern \"$THEME-export-palette\"))
        (sem  (intern \"$THEME-palette\")))
    (dolist (mode '(light dark))
      (let ((frame-background-mode mode)
            (i 0))
        (dolist (hex (funcall ansi 'hex-list))
          (princ (format \"%s ansi %d %s\n\" mode i (substring hex 1)))
          (setq i (1+ i)))
        (dolist (cell (funcall sem))
          (princ (format \"%s sem %s %s\n\" mode (car cell) (substring (cdr cell) 1))))))))")"

# HEX of KIND KEY in VARIANT.
color() {
  printf '%s\n' "$data" | awk -v v="$1" -v k="$2" -v n="$3" \
    '$1 == v && $2 == k && $3 == n { print $4; exit }'
}

header() {
  printf '%s %s -- generated by gen-theme-palette from %s-theme; do not edit.\n' "$1" "$2" "$THEME"
  printf '%s Regenerate with: gen-theme-palette %s\n' "$1" "$THEME"
}

mkdir -p "$REPO/config/ghostty/themes" "$REPO/config/mintty/themes" \
         "$REPO/config/everything/themes"

for variant in light dark; do
  # Ghostty: palette = N=#rrggbb, plus the three singular colors.
  out="$REPO/config/ghostty/themes/$THEME-$variant"
  {
    header '#' "$THEME-$variant"
    for i in $(seq 0 15); do
      printf 'palette = %d=#%s\n' "$i" "$(color "$variant" ansi "$i")"
    done
    printf 'background = #%s\n'   "$(color "$variant" sem mono1)"
    printf 'foreground = #%s\n'   "$(color "$variant" sem mono7)"
    printf 'cursor-color = #%s\n' "$(color "$variant" sem mono6)"
  } > "$out"
  echo "wrote $out"

  # mintty: the sixteen by name, as decimal R,G,B.
  out="$REPO/config/mintty/themes/$THEME-$variant"
  names=(Black Red Green Yellow Blue Magenta Cyan White
         BoldBlack BoldRed BoldGreen BoldYellow BoldBlue BoldMagenta BoldCyan BoldWhite)
  rgb() { printf '%d,%d,%d' "0x${1:0:2}" "0x${1:2:2}" "0x${1:4:2}"; }
  {
    header '#' "$THEME-$variant"
    for i in $(seq 0 15); do
      printf '%s=%s\n' "${names[$i]}" "$(rgb "$(color "$variant" ansi "$i")")"
    done
    printf 'BackgroundColour=%s\n' "$(rgb "$(color "$variant" sem mono1)")"
    printf 'ForegroundColour=%s\n' "$(rgb "$(color "$variant" sem mono7)")"
    printf 'CursorColour=%s\n'     "$(rgb "$(color "$variant" sem mono6)")"
  } > "$out"
  echo "wrote $out"

  # Everything: every item state as #RRGGBB.  A key left empty falls back to
  # Windows's light default, so each state is given both colors.  Each state
  # also has a `_highlighted' form, the same item with the search term in it;
  # the normal state's is plain `highlighted'.
  out="$REPO/config/everything/themes/$THEME-$variant.ini"
  fg="#$(color "$variant" sem mono7)"
  match="#$(color "$variant" sem cyan)"
  surface="#$(color "$variant" sem mono1)"
  current="#$(color "$variant" sem mono0)"
  other="#$(color "$variant" sem mono2)"
  state() {
    local hl="${1}_highlighted"
    [ "$1" = normal ] && hl=highlighted
    printf '%s_foreground_color=%s\n' "$1" "$fg"
    printf '%s_background_color=%s\n' "$1" "$2"
    printf '%s_foreground_color=%s\n' "$hl" "$match"
    printf '%s_background_color=%s\n' "$hl" "$2"
  }
  {
    header ';' "$THEME-$variant"
    printf '[Everything]\n'
    state normal                       "$surface"
    state alternate_row                "$surface"
    state current_sort                 "$surface"
    state current_sort_alternate_row   "$surface"
    state selected                     "$current"
    state mouseover                    "$current"
    state mouseover_current_sort       "$current"
    state selected_inactive            "$other"
    state drop_target                  "$other"
    printf 'preview_background_color=%s\n' "$surface"
    printf 'thumbnail_mouseover_border_color=#%s\n' "$(color "$variant" sem mono6)"
  } > "$out"
  echo "wrote $out"
done

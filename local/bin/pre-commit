#!/usr/bin/env bash
# leakseek + gitleaks + check-japanese + check-package-scope pre-commit
# checker, for this repository and every package written here alike.
#
# The packages are published as this repository is, so they are held to the
# same keyword list.  Where a keyword is meant to be there -- a placeholder in
# a redaction test, a licence's own wording -- ~/.config/.leakseek.allow lets
# that one line through (leakseek --help), and stays on the machine with the
# list.

set -e

show_help() {
  cat <<EOF
Usage:
  pre-commit [--help]

Run leakseek, gitleaks, the Japanese character check and the package scope
check before committing.

🪝 Installed by bootstrap, in the dotfiles repository and in every package
working tree under ~/Developer.  By hand, in a repository:
     ln -sf ~/.local/bin/pre-commit .git/hooks/pre-commit

💡 You can also test it manually from anywhere inside the repo:
     pre-commit

🚨 What this script does:
- Runs 'leakseek' on the tracked files, with ~/.config/.leakseek.allow
- Runs 'gitleaks detect' from the repo root
- Checks for Japanese characters in source files
- Warns when a package repo describes one particular machine
  (check-package-scope; a no-op in the dotfiles repo itself)

The commit *message* is a separate hook: see ~/.local/bin/commit-msg.
- If any check fails, the commit is aborted
- If all checks pass, the commit proceeds

EOF
}

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  show_help
  exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

echo "🔒 Running leakseek on tracked files (no .git)..."
if ! git ls-files -z | xargs -0 leakseek; then
  echo "❌ leakseek failed. Commit aborted."
  exit 1
fi

echo "🔒 Running gitleaks..."
if ! gitleaks detect --no-banner --redact --source .; then
  echo "❌ gitleaks found potential leaks. Commit aborted."
  exit 1
fi

echo "🈲 Running Japanese character check..."
if ! check-japanese "$REPO_ROOT"; then
  echo "⚠️ Japanese character check warning."
  # no exit, just warning
fi

# Silent in this repository, which is allowed to be about one machine.
# Elsewhere it warns when a package has started describing my setup.
check-package-scope "$REPO_ROOT" || true

echo "✅ All checks passed."

# --- per-machine, never tracked -----------------------------------------------
# These are meant to live beside the deployed symlinks, in ~/.emacs.d and
# ~/.config/shell/env, where the repository cannot reach them.  Named here as
# well for the hand that edits the repository copy instead.
local.el
local.sh
custom.el
allow-straight-pull

# --- leakseek -----------------------------------------------------------------
.leakseek_keyword

# --- Claude Code --------------------------------------------------------------
# Claude-owned, runtime-mutated state (settings.json, session/plugin state).
.claude/

# --- Windows ------------------------------------------------------------------
desktop.ini
*.exe
*.lnk

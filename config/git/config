[alias]
	graph = log --pretty=format:"%C(yellow)%h%Creset %Cgreen%ar%Creset %Cblue%<(8,trunc)%an%Creset %C(auto)%d%Creset %s" --graph

[core]
	editor = emacsclient
	pager = less -FRX
	# EOL is enforced per-repo via .gitattributes (text=auto eol=lf, Unix/macOS
	# style, matching Emacs utf-8-unix). Disable Git-for-Windows' default
	# LF->CRLF checkout conversion so it never re-introduces CRLF drift.
	autocrlf = false

[merge]
	conflictstyle = zdiff3

[init]
	defaultBranch = main

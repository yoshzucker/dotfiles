# === Ghostty ===

# --- Font ---
font-family = "PlemolJP Console NF"
font-size = 13
# font-feature = "liga"

# --- Key Handling ---
macos-option-as-alt = true

# --- Appearance ---
# Colors from config/ghostty/themes, which gen-theme-palette writes.  The zsh
# prompt names this theme's slots and follows it.
theme = gensho-light
window-padding-x = 6
window-padding-y = 6
# window-decoration = false
# background-opacity = 1.0

# --- Others ---
# Unit is BYTES (not lines). 10MB ≈ tens of thousands of lines.
scrollback-limit = 10000000

# Wheel scroll amount. Default is discrete(mouse)=3 / precision(trackpad)=1, so a
# mouse wheel scrolls 3 lines per notch. Pin to 1 → 1 line per notch with a
# discrete mouse too, so the text can be followed while it moves.
mouse-scroll-multiplier = 1
copy-on-select = true
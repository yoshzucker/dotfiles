#!/usr/bin/env bash

set -euo pipefail
IFS=$'\n\t'


# =============================================================================
# Command Line
# =============================================================================

usage() {
  cat <<'EOF'
bootstrap — dotfiles environment bootstrapper (macOS; Windows has bootstrap.ps1)

Usage:
  ./bootstrap [bootstrap]      # Install what is missing, then link (a fresh machine, or any time)
  ./bootstrap link             # Create or refresh links only -- what a git pull needs
  ./bootstrap outdated         # List what update would upgrade, and change nothing
  ./bootstrap update           # Upgrade every Homebrew package, then link
  ./bootstrap unlink           # Remove only links managed by this repo
  ./bootstrap doctor [--fix]   # Report (or remove) broken links
  -h, --help                   # Show this help

A fresh machine:
  git clone https://github.com/yoshzucker/dotfiles.git ~/dotfiles
  ~/dotfiles/bootstrap

Nothing here upgrades a package except `update', which is asked for by name;
`outdated' says first what it would do, and `brew upgrade NAME' takes one.
A real file in the way of a link is moved under
${XDG_DATA_HOME:-~/.local/share}/dotfiles/backups/ first.
EOF
}

mode="${1:-bootstrap}"
[ $# -gt 0 ] && shift
doctor_fix=0

case "$mode" in
  -h|--help) usage; exit 0 ;;
  bootstrap|link|outdated|update|unlink) ;;
  doctor)
    if [ "${1:-}" = "--fix" ]; then
      doctor_fix=1
      shift
    fi
    ;;
  *) echo "Unknown subcommand: $mode" >&2; usage >&2; exit 1 ;;
esac
if [ $# -gt 0 ]; then
  echo "Unexpected argument: $1" >&2
  usage >&2
  exit 1
fi

if [ "$(uname -s)" != "Darwin" ]; then
  echo "This bootstrap is for macOS; on Windows run bootstrap.ps1." >&2
  exit 1
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
canon_script="$(realpath "$script_dir")"

# Set when a step fails without stopping the rest, so the run still ends in
# failure rather than in "Finished."
failed=0


# =============================================================================
# Output
# =============================================================================

print_line() {
  local left="$1"
  local right="$2"
  local fill_char="${3:-.}"

  local cols
  cols=$(tput cols 2>/dev/null || echo 80)

  local left_len=${#left}
  local right_len=${#right}
  local total_len=$(( left_len + right_len ))

  local lines=$(( (total_len + cols - 1) / cols ))
  [ "$lines" -lt 1 ] && lines=1

  local fill_len=$(( lines * cols - total_len ))

  local filler=""
  while [ ${#filler} -lt "$fill_len" ]; do
    filler="${filler}${fill_char}"
  done

  printf "%s%s%s\n" "$left" "$filler" "$right"
}


# =============================================================================
# Links
# =============================================================================

is_broken_link() {
  [ -L "$1" ] && [ ! -e "$1" ]
}

# A link into this repository: what `unlink' may remove and nothing else.
is_managed_link() {
  local target
  [ -L "$1" ] || return 1
  target="$(realpath "$1" 2>/dev/null || true)"
  [ -n "$target" ] && [[ "$target" == "$canon_script"* ]]
}

# The links under DIR, NUL-separated.  `top' lists DIR's own entries -- the
# only depth raw $HOME is ever read at -- and `all' descends, past the
# directories that are generated rather than written: dependency trees,
# caches, straight's clones and builds, Emacs's state.  Not the rest of
# straight/: the lockfile is linked into straight/versions.
#
# `env' is pruned only where it is a virtualenv.  The name is a word, and one
# of the directories this repository deploys is called it -- config/shell/env
# -- so pruning by name alone hid every link under it.  A virtualenv carries a
# pyvenv.cfg (PEP 405); the other names are not words and need no such test.
links_under() {
  local dir="$1" depth="$2"
  [ -d "$dir" ] || return 0
  if [ "$depth" = top ]; then
    find "$dir" -maxdepth 1 -type l -print0 2>/dev/null
    return 0
  fi
  find "$dir" \
    -type d \( \
      -name "myenv" -o -name ".venv" -o -name "venv" -o \
      \( -name "env" -a -exec test -e "{}/pyvenv.cfg" \; \) -o \
      -name "node_modules" -o -name "__pycache__" -o \
      -name ".mypy_cache" -o -name ".pytest_cache" -o -name ".ruff_cache" -o \
      -name "target" -o -name "build" -o -name "dist" -o \
      -path "*/straight/repos" -o -path "*/straight/build" -o \
      -name "var" -o -name "elpa" -o -name "eln" -o \
      -name "auto-save-list" -o -name "backups" -o -name "transient" -o \
      -name ".cache" \
    \) -prune -o \
    -type l -print0 2>/dev/null
}

# Do ACTION to the links under DIR at DEPTH (see `links_under'):
#   report-broken   print each broken link
#   remove-broken   delete each broken link
#   remove-managed  delete each link into this repository
# With QUIET, say nothing when there was nothing to do.
scan_links() {
  local dir="$1" depth="$2" action="$3" quiet="${4:-}"
  local link count=0
  while IFS= read -r -d '' link; do
    case "$action" in
      report-broken)
        is_broken_link "$link" || continue
        echo "Broken: $link"
        ;;
      remove-broken)
        is_broken_link "$link" || continue
        echo "🗑️  Removing broken link: $link"
        rm -f "$link"
        ;;
      remove-managed)
        is_managed_link "$link" || continue
        echo "🗑️  Removing managed link: $link → $(realpath "$link")"
        rm -f "$link"
        ;;
    esac
    count=$((count + 1))
  done < <(links_under "$dir" "$depth")
  if [ "$count" -eq 0 ] && [ -z "$quiet" ]; then
    echo "  (none)"
  fi
}

# Every place links are made in: raw $HOME at its top level only, the rest
# all the way down.
link_places=("$HOME/.config" "$HOME/.local" "$HOME/.emacs.d" "$HOME/.claude/skills")

scan_all_link_places() {
  local action="$1" dir
  echo "=== ~ (top level only) ==="
  scan_links "$HOME" top "$action"
  for dir in "${link_places[@]}"; do
    echo
    echo "=== ${dir/#$HOME/~} ==="
    scan_links "$dir" all "$action"
  done
}

ensure_real_directory() {
  local path="$1"
  if [ -L "$path" ]; then
    echo "🔁 Replacing link with real directory: $path"
    rm -f "$path"
  fi
  mkdir -p "$path"
}

backup_conflicting_file() {
  local conflict="$1"
  local ts
  ts="$(date +%Y%m%d-%H%M%S)"
  local backup_root="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/backups/${ts}"
  local rel_path="${conflict#"$HOME"/}"
  local backup_path="$backup_root/$rel_path"

  mkdir -p "$(dirname "$backup_path")"
  mv "$conflict" "$backup_path"

  echo "⚠️  Conflict: $conflict was a real file."
  echo "    Backed up to: $backup_path"
  echo "    Proceeding to create link."
}

# Link each entry of SRC into DEST, which is made a real directory.  A
# directory in SRC becomes a real directory in DEST with its contents linked
# in turn, so a program can write beside the linked files; with --whole, it is
# linked as one, for a directory that is a unit (a skill).  A link already
# right is left alone; a wrong one is replaced; a real file is backed up.
link_tree() {
  local src_dir="$1" dest_dir="$2" whole="${3:-}"
  local src name dest

  ensure_real_directory "$dest_dir"

  shopt -s nullglob dotglob
  for src in "$src_dir"/*; do
    name="$(basename "$src")"
    case "$name" in .DS_Store) continue ;; esac
    dest="$dest_dir/$name"

    if [ -d "$src" ] && [ ! -L "$src" ] && [ -z "$whole" ]; then
      link_tree "$src" "$dest"
      continue
    fi
    if [ -L "$dest" ]; then
      [ "$(readlink "$dest")" = "$src" ] && continue
      echo "🔁 Replacing link: $dest"
      rm -f "$dest"
    elif [ -e "$dest" ]; then
      backup_conflicting_file "$dest"
    fi
    ln -s "$src" "$dest"
    echo "✅ Linked: $dest → $src"
  done
  shopt -u nullglob dotglob
}

link_git_hooks() {
  # The checks every commit here goes through -- pre-commit (leakseek,
  # gitleaks, the Japanese and package scope checks) and commit-msg -- linked
  # into REPO's .git/hooks from ~/.local/bin.  Linked rather than copied, so a
  # change to a check reaches every repository at once.  A hook already there
  # that is something else is replaced.  A repository made with `git init' or
  # cloned has none of these, and its commits go unchecked until it does.
  local repo="$1"
  local hooks="$repo/.git/hooks"
  local hook src dest

  [ -d "$repo/.git" ] || return 0
  mkdir -p "$hooks"

  for hook in pre-commit commit-msg; do
    src="$HOME/.local/bin/$hook"
    dest="$hooks/$hook"
    if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$src" ]; then
      continue
    fi
    rm -f "$dest"
    ln -s "$src" "$dest"
    echo "✅ Hook linked: $dest → $src"
  done
}

warn_missing_leakseek_conf() {
  # The hooks abort every commit until this machine has a keyword list: a
  # check with nothing to check against would pass everything and say
  # nothing.  The list, and the allow file beside it, never leave the
  # machine, so bootstrap cannot bring them; it says what is missing.
  local conf="${XDG_CONFIG_HOME:-$HOME/.config}/.leakseek.conf"
  if [ ! -f "$conf" ]; then
    echo "⚠️  No leakseek keyword list at $conf: commits in the repositories"
    echo "   with hooks are aborted until there is one.  'leakseek --template'"
    echo "   writes an empty one to fill in."
  fi
}

setup_links() {
  local left_message="Linking dotfiles"
  print_line "$left_message" "Started."

  # Links whose files were deleted from the repository go first, or a module
  # removed here is still required by a dangling link and Emacs fails to start.
  local dir
  scan_links "$HOME" top remove-broken quiet
  for dir in "${link_places[@]}"; do
    scan_links "$dir" all remove-broken quiet
  done

  link_tree "$script_dir/home" "$HOME"
  link_tree "$script_dir/config" "$HOME/.config"
  link_tree "$script_dir/emacs.d" "$HOME/.emacs.d"
  link_tree "$script_dir/local/bin" "$HOME/.local/bin"

  # This repository's own commits go through the hooks just linked into
  # ~/.local/bin, on every machine it is cloned to; setup_dev_packages does
  # the same for the packages.
  link_git_hooks "$script_dir"
  warn_missing_leakseek_conf

  # Skills are the one part of ~/.claude worth tracking: plain files that never
  # get rewritten, and rules that have to be in front of every project -- the
  # packages in ~/Developer included, which this repo does not otherwise reach.
  # The rest of ~/.claude is Claude Code's own, rewritten at runtime.
  link_tree "$script_dir/claude/skills" "$HOME/.claude/skills" --whole

  print_line "$left_message" "Finished."
}

setup_dev_packages() {
  # Packages written here rather than merely used: point straight's clone at
  # the working tree in ~/Developer, so editing a package and restarting Emacs
  # is enough to see the change.  Without this the loaded copy is straight's
  # own clone, and every experiment costs a commit, a push and a pull.
  #
  # Skipped silently where the working tree is absent -- a machine that only
  # uses these packages should let straight clone them as usual.  A clone that
  # has anything of its own in it is left alone and reported: work done in the
  # wrong directory is still work, and this is not the place to discover it is
  # gone.
  local left_message="Linking developed packages"
  print_line "$left_message" "Started."

  local repos="$HOME/.emacs.d/straight/repos"
  local build="$HOME/.emacs.d/straight/build"
  local pkg src dest

  for pkg in \
      org-foresight \
      org-calsync \
      org-convect \
      org-dayflow \
      org-truss \
      org-moor \
      org-item-tags \
      sill \
      gensho-theme \
      rustcity-theme
  do
    src="$HOME/Developer/$pkg"
    dest="$repos/$pkg"

    [ -d "$src" ] || continue

    # A working tree is where the package is committed from, so its commits
    # go through the same hooks as this repository's.  straight's own clones
    # are never committed from and get none.
    link_git_hooks "$src"

    if [ -L "$dest" ]; then
      [ "$(realpath "$dest" 2>/dev/null)" = "$(realpath "$src")" ] && continue
      echo "🔁 Replacing link: $dest"
      rm -f "$dest"
    elif [ -d "$dest" ]; then
      # straight's own clone.  Safe to drop only when it holds nothing that
      # is not already elsewhere.
      if [ -n "$(git -C "$dest" status --porcelain 2>/dev/null)" ]; then
        echo "⚠️ Skipping $pkg: straight's clone has uncommitted changes"
        continue
      fi
      if [ -n "$(git -C "$dest" log --oneline '@{u}..HEAD' 2>/dev/null)" ]; then
        echo "⚠️ Skipping $pkg: straight's clone has unpushed commits"
        continue
      fi
      rm -rf "$dest"
    fi

    mkdir -p "$repos"
    ln -s "$src" "$dest"
    # The build is a copy of whatever was there before; drop it so the next
    # start rebuilds from the working tree.
    rm -rf "${build:?}/$pkg"
    echo "✅ Linked: $dest → $src"
  done

  print_line "$left_message" "Finished."
}

unlink_dotfiles() {
  # Removes the links whose targets are inside this repository.  Real files
  # and links made by anything else are never touched.
  local left_message="Unlinking dotfiles"
  print_line "$left_message" "Started."
  scan_all_link_places remove-managed
  echo
  print_line "$left_message" "Finished."
}

doctor() {
  local left_message="Running doctor"
  print_line "$left_message" "Started."

  if [ "$doctor_fix" -eq 1 ]; then
    scan_all_link_places remove-broken
    echo
    print_line "$left_message" "Finished (fix mode)."
  else
    scan_all_link_places report-broken
    echo
    print_line "$left_message" "Finished (report only)."
    echo
    echo "Tip: Run './bootstrap doctor --fix' to remove broken links."
  fi
}


# =============================================================================
# Packages
# =============================================================================

install_brew() {
  # Homebrew itself, by its official installer, where it is missing.
  if command -v brew >/dev/null; then
    return
  fi

  local left_message="Installing Homebrew"
  print_line "$left_message" "Started."

  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null)"

  print_line "$left_message" "Finished."
}

# Bring the system to pkg/brew/Brewfile.  `--no-upgrade' installs what is
# missing and leaves what is there at its version; `--upgrade' moves every
# entry to the latest.  Homebrew installs only its current version of a
# formula, so there is no lockfile to keep: an upgrade is asked for by name,
# with `update', or not done.  A failed entry fails the run, after the rest.
brew_bundle() {
  local how="$1"
  command -v brew >/dev/null || return 0

  local left_message="Brew packages ($how)"
  print_line "$left_message" "Started."

  brew update
  if ! HOMEBREW_NO_AUTO_UPDATE=1 brew bundle --file "$script_dir/pkg/brew/Brewfile" "--$how"; then
    echo "⚠️  Some Brewfile entries failed; see above."
    failed=1
  fi
  brew cleanup

  print_line "$left_message" "Finished."
}

# What `update' would upgrade, current and new version side by side.  Only
# Homebrew's own index is refreshed; nothing installed changes.  `--greedy'
# includes the casks that update themselves, which `brew bundle --upgrade'
# moves too.
brew_outdated() {
  command -v brew >/dev/null || return 0
  brew update --quiet
  brew outdated --greedy --verbose
}

install_fonts() {
  # Builds and installs "PlemolJP NF" (non-Console PlemolJP + Nerd icons;
  # Japanese prose 2-cell, drawing/UI 1-cell — see local/bin/build-plemoljp-nf).
  # Idempotent: skips when already installed.
  #
  # fontforge is installed for the build and removed after, where it was not
  # there before: a build is rare, and a large C program that parses fonts
  # is not worth keeping for it.  Windows does not build; it takes the built
  # files by hand (bootstrap.ps1, Install-Fonts).
  if [ -f "$HOME/Library/Fonts/PlemolJPNF-Regular.ttf" ]; then
    return
  fi

  local fontforge_added=0
  if ! command -v fontforge >/dev/null 2>&1; then
    if ! command -v brew >/dev/null 2>&1 || ! brew install fontforge; then
      echo "fontforge not available; skipping PlemolJP NF font build."
      failed=1
      return
    fi
    fontforge_added=1
  fi

  local left_message="Building PlemolJP NF font"
  print_line "$left_message" "Started."

  if ! "$script_dir/local/bin/build-plemoljp-nf"; then
    echo "⚠️  PlemolJP NF build failed."
    failed=1
  fi

  if [ "$fontforge_added" -eq 1 ]; then
    brew uninstall fontforge && brew autoremove
  fi

  print_line "$left_message" "Finished."
}


# =============================================================================
# Main
# =============================================================================

show_restart_notice() {
  echo
  echo "Bootstrap step '$mode' complete. To apply shell changes, run:"
  echo "  exec \$SHELL -l"
  echo
}

case "$mode" in
  bootstrap)
    install_brew
    brew_bundle no-upgrade
    install_fonts
    setup_links
    setup_dev_packages
    show_restart_notice
    ;;
  link)
    setup_links
    setup_dev_packages
    ;;
  outdated) brew_outdated ;;
  update)
    brew_bundle upgrade
    setup_links
    setup_dev_packages
    show_restart_notice
    ;;
  unlink) unlink_dotfiles ;;
  doctor) doctor ;;
esac

exit "$failed"
